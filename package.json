{
  "name": "@cashgear/ui",
  "version": "0.1.0",
  "description": "CashGear internal React UI component library — generic, strongly typed building blocks for ERP, POS, Shipping and future CashGear business applications.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/cashgear-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedSadat/CashGear.React.UI.git"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run typecheck && npm run build:lib",
    "build:lib": "vite build",
    "prepare": "npm run build:lib",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "storybook:serve": "vite preview --host 127.0.0.1 --port 6006 --strictPort --outDir storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "npm run build-storybook && npm run test:browser:built",
    "test:browser:built": "playwright test",
    "test:browser:semantic": "npm run build-storybook && playwright test --project=chromium-semantic --project=firefox-semantic --project=webkit-semantic",
    "test:browser:visual": "npm run build-storybook && playwright test --project=chromium-visual",
    "test:browser:update": "npm run build-storybook && playwright test --project=chromium-visual --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:cycles": "node scripts/check-cycles.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:cycles && npm run clean && npm run build:lib && npm run build-storybook && npm run test:browser:built && npm run verify:package",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "10.5.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.11"
  }
}
